{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{apps/api/dist/**,packages/shared/dist/**,packages/shared/package.json,apps/api/prisma/**,node_modules/.prisma/**,node_modules/@prisma/**}"
    }
  },
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/agent/cron/cleanup-conversations",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/backup/internal/run-scheduled",
      "schedule": "30 19 * * *"
    }
  ]
}
