{
  "buildCommand": "npm run build",
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/agent/cron/cleanup-conversations",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/backup/internal/run-scheduled",
      "schedule": "30 19 * * *"
    }
  ]
}
